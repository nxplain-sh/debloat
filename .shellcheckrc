# ShellCheck configuration — https://www.shellcheck.net
# Applies to `make shellcheck` and the CI lint job.

# Analyze scripts as bash regardless of how they're invoked.
shell=bash

# This project sources no external files; don't try to follow `source`/`.`.
external-sources=false

# Stricter optional checks (SC2250 brace-all-variables, SC2312, etc.) are left
# off: the script intentionally uses unbraced "$var". To opt in later:
#   enable=all
